{
  "name": "with-docker",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "clean": "turbo run clean",
    "dev": "turbo run dev",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "generate-ui-resource": "ts-node scripts/generate-ui-resource.ts",
    "generate-api-resource": "ts-node scripts/generate-api-resource.ts",
    "db:generate:name": "cd apps/api && npx drizzle-kit generate --name=$name",
    "db:generate": "cd apps/api && npx drizzle-kit generate",
    "db:migrate": "cd apps/api && npx drizzle-kit migrate",
    "db:studio": "cd apps/api && npx drizzle-kit studio",
    "db:seed": "cd apps/api && npx tsx ./src/db/seed.ts",
    "db:up": "npm run db:generate && npm run db:migrate",
    "db:export": "cd apps/api && npx drizzle-kit export"
  },
  "devDependencies": {
    "@babel/cli": "^7.25.9",
    "@babel/core": "^7.26.0",
    "@babel/plugin-proposal-decorators": "^7.25.9",
    "@babel/preset-env": "^7.26.0",
    "prettier": "^3.2.5",
    "turbo": "^2.1.3"
  },
  "packageManager": "yarn@1.22.19",
  "engines": {
    "node": ">=14.0.0",
    "npm": ">=7.0.0"
  }
}
